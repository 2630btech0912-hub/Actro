name: Deploy Edge Functions

on:
  push:
    branches:
      - main
  workflow_dispatch:

permissions:
  contents: read

jobs:
  deploy:
    runs-on: ubuntu-latest
    env:
      SUPABASE_ACCESS_TOKEN: ${{ secrets.sbp_b30629ceabff69457a6d42e9ee62bcc3362399ad }}
      SUPABASE_PROJECT_ID: ${{ secrets.gtnhnrloufzhzsenkxft }}

    steps:
      - uses: actions/checkout@v4

      - uses: supabase/setup-cli@v1
        with:
          version: latest

      - run: supabase functions deploy --project-ref $SUPABASE_PROJECT_ID
