import { GoogleGenAI, Type, Schema } from "@google/genai";

const ai = new GoogleGenAI();

export interface Relevance {
  applies_to_user: boolean;
  score: number;
  reasons: string[];
  missing_profile_data: string[];
}

export interface ExtractedAction {
  temp_id: string;
  action_title: string;
  explicit_deadline: string | null;
  deadline_confidence: "high" | "medium" | "low" | null;
  lead_time_days_estimate: number | null;
  required_prerequisites: string[];
  source_text_quote: string;
}

export interface DocumentAnalysisResult {
  category:
    | "Exam"
    | "Scholarship"
    | "Fee"
    | "Internship"
    | "Hackathon"
    | "Event"
    | "General Notice"
    | "Other";
  action_status:
    | "Action Required"
    | "Information Only"
    | "Optional Opportunity"
    | "Already Completed"
    | "Not Relevant";
  relevance: Relevance;
  extracted_actions: ExtractedAction[];
}

const analysisSchema: Schema = {
  type: Type.OBJECT,
  properties: {
    category: {
      type: Type.STRING,
      enum: [
        "Exam",
        "Scholarship",
        "Fee",
        "Internship",
        "Hackathon",
        "Event",
        "General Notice",
        "Other",
      ],
    },
    action_status: {
      type: Type.STRING,
      enum: [
        "Action Required",
        "Information Only",
        "Optional Opportunity",
        "Already Completed",
        "Not Relevant",
      ],
    },
    relevance: {
      type: Type.OBJECT,
      properties: {
        applies_to_user: { type: Type.BOOLEAN },
        score: { type: Type.NUMBER },
        reasons: {
          type: Type.ARRAY,
          items: { type: Type.STRING },
        },
        missing_profile_data: {
          type: Type.ARRAY,
          items: { type: Type.STRING },
        },
      },
      required: [
        "applies_to_user",
        "score",
        "reasons",
        "missing_profile_data",
      ],
    },
    extracted_actions: {
      type: Type.ARRAY,
      items: {
        type: Type.OBJECT,
        properties: {
          temp_id: { type: Type.STRING },
          action_title: { type: Type.STRING },
          explicit_deadline: { type: Type.STRING, nullable: true },
          deadline_confidence: {
            type: Type.STRING,
            enum: ["high", "medium", "low"],
            nullable: true,
          },
          lead_time_days_estimate: { type: Type.NUMBER, nullable: true },
          required_prerequisites: {
            type: Type.ARRAY,
            items: { type: Type.STRING },
          },
          source_text_quote: { type: Type.STRING },
        },
        required: [
          "temp_id",
          "action_title",
          "explicit_deadline",
          "deadline_confidence",
          "lead_time_days_estimate",
          "required_prerequisites",
          "source_text_quote",
        ],
      },
    },
  },
  required: ["category", "action_status", "relevance", "extracted_actions"],
};

export async function analyzeDocument(
  rawDocumentText: string,
  userProfile: Record<string, any>
): Promise<DocumentAnalysisResult> {
  const systemInstruction = `You are the Actra Action Extraction Engine.
Your task is to analyze document text, assess applicability against a target profile, and extract actionable facts without summarizing.

Strict Rules:
- Never hallucinate facts or consequences.
- If information is missing, return null or an empty array.
- Label every inference clearly.
- Determine relevance strictly against the provided profile.
- DEADLINE HANDLING:
  * Do NOT invent or fabricate dates or years.
  * If a deadline specifies a day or month (e.g., "August 20") but the year cannot be confidently determined from the document, return the exact text representation without inventing a year.
  * Assign 'deadline_confidence':
    - 'high': Complete date/time explicitly stated with year.
    - 'medium': Date partially specified (e.g., day/month given, year inferred from surrounding document context or omitted).
    - 'low': Ambiguous timeframe, relative or vague reference.
    - null: No deadline present.
- Do not invent eligibility.
- Do not invent consequences.
- Preserve uncertainty when the source is ambiguous.`;

  const prompt = `TARGET USER PROFILE (JSON):
${JSON.stringify(userProfile, null, 2)}

DOCUMENT TEXT TO ANALYZE:
---
${rawDocumentText}
---`;

  const response = await ai.models.generateContent({
    model: "gemini-2.5-flash",
    contents: prompt,
    config: {
      systemInstruction,
      responseMimeType: "application/json",
      responseSchema: analysisSchema,
      temperature: 0.1,
    },
  });

  if (!response.text) {
    throw new Error("No response returned by the model.");
  }

  return JSON.parse(response.text) as DocumentAnalysisResult;
}
